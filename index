var tt = document.getElementById('tt');
document.addEventListener('mouseover', function(e){
  var el = e.target.closest ? e.target.closest('[data-tip]') : null;
  if (!el) return;
  tt.innerHTML = el.getAttribute('data-tip');
  tt.setAttribute('data-on', '1');
});
document.addEventListener('mousemove', function(e){
  if (tt.getAttribute('data-on') !== '1') return;
  var w = tt.offsetWidth, h = tt.offsetHeight;
  var x = e.clientX + 14, y = e.clientY - h - 12;
  if (x + w > innerWidth - 8) x = e.clientX - w - 14;
  if (y < 8) y = e.clientY + 18;
  tt.style.left = x + 'px'; tt.style.top = y + 'px';
});
document.addEventListener('mouseout', function(e){
  var el = e.target.closest ? e.target.closest('[data-tip]') : null;
  if (el) tt.setAttribute('data-on', '0');
});

/* ======================= KPI ======================= */
/* Décompte : première visite en 950 ms, puis 420 ms sur changement de filtre —
   assez court pour lire un chiffre en transit comme un rafraîchissement, pas
   comme une valeur. Désactivé si le visiteur refuse les animations. */
var premierRendu = true;
function compte(el, cible, fmt, duree){
  if (SANS_MOUVEMENT || duree <= 0 || !isFinite(cible)){ el.textContent = fmt(cible); return; }
  var depart = performance.now();
  function pas(now){
    var p = Math.min(1, (now - depart) / duree);
    var e = 1 - Math.pow(1 - p, 3);
    el.textContent = fmt(cible * e);
    if (p < 1) requestAnimationFrame(pas);
    else el.textContent = fmt(cible);
  }
  requestAnimationFrame(pas);
}

/* Sparkline mensuelle : une courbe monotone, son aire et son point final.
   Sous deux mois renseignés il n'y a pas de tendance à tracer. */
function sparkline(serie, color){
  var live = serie.filter(function(p){ return p; });
  if (live.length < 2) return '';
  var W = 200, H = 34, pad = 4;
  var vals = live.map(function(p){ return p.v; });
  var mx = Math.max.apply(null, vals), mn = Math.min.apply(null, vals);
  var span = mx - mn || 1;
  var uid = ++UID;
  var pts = live.map(function(p, i){
    return [pad + (W - 2 * pad) * (i / (live.length - 1)),
            pad + (H - 2 * pad) * (1 - (p.v - mn) / span)];
  });
  var d = monotone(pts), last = pts[pts.length - 1];
  return '<svg class="spark" viewBox="0 0 ' + W + ' ' + H + '" aria-hidden="true">' +
    '<defs><linearGradient id="sp' + uid + '" x1="0" y1="0" x2="0" y2="1">' +
    '<stop offset="0%" stop-color="' + color + '" stop-opacity="1"/>' +
    '<stop offset="100%" stop-color="' + color + '" stop-opacity="0"/></linearGradient>' +
    '<clipPath id="spc' + uid + '"><rect class="grow-h" x="0" y="0" width="' + W + '" height="' + H +
    '" style="animation-duration:.9s;animation-delay:.25s"/></clipPath></defs>' +
    '<g clip-path="url(#spc' + uid + ')">' +
    '<path class="spark-area" d="' + d + 'L' + last[0].toFixed(1) + ',' + H + 'L' + pts[0][0].toFixed(1) + ',' + H +
    'Z" fill="url(#sp' + uid + ')"/>' +
    '<path class="spark-line" d="' + d + '" stroke="' + color + '" vector-effect="non-scaling-stroke"/></g>' +
    '<circle class="spark-end pop" cx="' + last[0].toFixed(1) + '" cy="' + last[1].toFixed(1) +
    '" r="3.2" fill="' + color + '" style="animation-delay:1.05s"/></svg>';
}

function renderKPI(t, rows){
  var by = moisIndex(rows);
  var serie = function(cle){
    return MOIS_AXE.map(function(m){ return by[m] ? {m: m, v: by[m][cle]} : null; });
  };
  var duree = SANS_MOUVEMENT ? 0 : (premierRendu ? 950 : 420);
  var tendance = function(cle){
    var live = serie(cle).filter(Boolean);
    if (live.length < 2) return '';
    return ' data-tip="' + tip('Tendance mensuelle', [
      [MOIS_LONG[live[0].m], fInt(live[0].v)],
      [MOIS_LONG[live[live.length - 1].m], fInt(live[live.length - 1].v)]
    ]) + '"';
  };

  var main = [
    {lab:'Publications sponsorisées', val:t.n, fmt:fInt, unit:'',
     note: t.n === DATA.rows.length ? 'Le fichier complet' : 'sur ' + fInt(DATA.rows.length) + ' au total',
     lead:true, cle:'n', col:'var(--rouge)'},
    {lab:'Budget investi', val:t.budget, fmt:fInt, unit:'€',
     note: t.n ? fCpm(t.budget / t.n) + ' par publication' : '—', cle:'budget', col:'var(--ambre)'},
    {lab:'Couverture', val:t.couv, fmt:fShort, unit:'',
     note:'personnes uniques atteintes', cle:'couv', col:'var(--rouge)'},
    {lab:'Vues / impressions', val:t.vues, fmt:fShort, unit:'',
     note: t.rep ? fRep(t.rep) + ' de répétition moyenne' : '—', cle:'vues', col:'var(--sarcelle)'},
    {lab:'Interactions', val:t.inter, fmt:fShort, unit:'',
     note: fInt(t.likes) + ' j&rsquo;aime · ' + fInt(t.com) + ' comm. · ' + fInt(t.part) + ' partages',
     cle:'inter', col:'var(--rouge)'}
  ];
  document.getElementById('kpi-main').innerHTML = main.map(function(k, i){
    return '<div class="kpi anim-rise' + (k.lead ? ' kpi--lead' : '') + '" style="animation-delay:' + (i * 0.055).toFixed(3) + 's">' +
      '<span class="kpi__label">' + k.lab + '</span>' +
      '<span class="kpi__val" data-i="' + i + '">' + k.fmt(k.val) + (k.unit ? '<span class="kpi__unit">' + k.unit + '</span>' : '') + '</span>' +
      '<span class="kpi__note">' + k.note + '</span>' +
      '<span' + tendance(k.cle) + '>' + sparkline(serie(k.cle), k.col) + '</span></div>';
  }).join('');
  /* le décompte porte sur le nœud texte, pas sur le <span> d'unité */
  main.forEach(function(k, i){
    var host = document.querySelector('#kpi-main .kpi__val[data-i="' + i + '"]');
    if (!host || !host.firstChild) return;
    var node = host.firstChild;
    compte({set textContent(v){ node.nodeValue = v; }}, k.val, k.fmt, duree);
  });

  var der = [
    ['Taux d&rsquo;engagement', t.eng == null ? '—' : fPct(t.eng), 'interactions ÷ vues'],
    ['Coût par interaction', fCost(t.cpi), t.cpi == null ? '—' : fCpm(t.cpi * 1000) + ' pour 1 000 interactions'],
    ['CPM', fCpm(t.cpm), 'coût pour mille vues']
  ];
  document.getElementById('kpi-derived').innerHTML = der.map(function(k, i){
    return '<div class="kpi anim-rise" style="animation-delay:' + (0.28 + i * 0.055).toFixed(3) + 's">' +
      '<span class="kpi__label">' + k[0] + '</span>' +
      '<span class="kpi__val">' + k[1] + '</span>' +
      '<span class="kpi__note">' + k[2] + '</span></div>';
  }).join('');
}

/* ======================= ÉVOLUTION MENSUELLE ======================= */
/* Géométrie commune aux trois graphiques mensuels (courbes, barres, budget) :
   même padL / padR / largeur de tranche, donc la bande budget reste alignée
   sous l'une comme sous l'autre vue. padR loge les étiquettes de fin de courbe. */
var GEO = {W: 1000, padL: 66, padR: 108, padT: 26, padB: 42};
function moisGeo(){
  var iw = GEO.W - GEO.padL - GEO.padR;
  return {iw: iw, slot: iw / MOIS_AXE.length, cx: function(i){ return GEO.padL + iw / MOIS_AXE.length * (i + 0.5); }};
}
function moisIndex(rows){
  var by = {};
  groupBy(rows, function(r){ return DATA.mois[r[MO]]; }).forEach(function(g){ by[g.key] = g; });
  return by;
}
function moisTip(m, g){
  return tip(MOIS_LONG[m], [
    ['Publications', fInt(g.n)], ['Budget', fEur(g.budget)],
    ['Couverture', fInt(g.couv)], ['Vues / impr.', fInt(g.vues)],
    ['Interactions', fInt(g.inter)],
    ['Taux engag.', g.eng == null ? '—' : fPct(g.eng)],
    ['Répétition', g.rep == null ? '—' : fRep(g.rep)]
  ]);
}
function moisAxis(by, geo, baseY, withCounts){
  var s = '';
  MOIS_AXE.forEach(function(m, i){
    var cx = geo.cx(i), g = by[m];
    s += '<text class="cat-label" x="' + cx.toFixed(1) + '" y="' + (baseY + 17) + '" text-anchor="middle">' + MOIS_COURT[m] + '</text>';
    if (!g) s += '<text class="gapmark" x="' + cx.toFixed(1) + '" y="' + (baseY + 30) + '" text-anchor="middle">AUCUNE</text>';
    else if (withCounts) s += '<text class="tick-label" x="' + cx.toFixed(1) + '" y="' + (baseY + 30) + '" text-anchor="middle">' + fInt(g.n) + ' pub.</text>';
  });
  return s;
}

/* ---------- vue courbes ---------- */
function renderMoisCourbes(rows){
  var by = moisIndex(rows), geo = moisGeo();
  var H = 330, ih = H - GEO.padT - GEO.padB, baseY = GEO.padT + ih;
  var max = niceMax(Math.max.apply(null, MOIS_AXE.map(function(m){
    return by[m] ? Math.max(by[m].couv, by[m].vues) : 0;
  }).concat([1])));
  var y = function(v){ return GEO.padT + ih - (v / max) * ih; };
  var uid = ++UID;

  var s = '';
  /* grille + graduations */
  ticks(max, 4).forEach(function(tv){
    s += '<line class="tick-line" x1="' + GEO.padL + '" y1="' + y(tv).toFixed(1) + '" x2="' + (GEO.W - GEO.padR) + '" y2="' + y(tv).toFixed(1) + '"/>';
    s += '<text class="tick-label" x="' + (GEO.padL - 9) + '" y="' + (y(tv) + 3.4).toFixed(1) + '" text-anchor="end">' + (tv === 0 ? '0' : fShort(tv)) + '</text>';
  });

  var SERIES_DEF = [
    {cle: 'couv', lab: 'Couverture', col: SERIES[0]},
    {cle: 'vues', lab: 'Vues / impr.', col: SERIES[1]}
  ];
  /* dégradés d'aire, un par série */
  s += '<defs>';
  SERIES_DEF.forEach(function(sd, k){
    s += '<linearGradient id="ar' + uid + '-' + k + '" x1="0" y1="0" x2="0" y2="1">' +
         '<stop offset="0%" stop-color="' + sd.col + '" stop-opacity=".26"/>' +
         '<stop offset="100%" stop-color="' + sd.col + '" stop-opacity="0"/></linearGradient>';
  });
  /* le tracé est révélé par un balayage : une seule animation pour les aires,
     les lignes et les points, quel que soit le nombre de tronçons */
  s += '<clipPath id="rv' + uid + '"><rect class="grow-h" x="' + GEO.padL + '" y="0" width="' +
       (GEO.W - GEO.padL) + '" height="' + H + '" style="animation-duration:1.05s"/></clipPath></defs>';

  s += '<g clip-path="url(#rv' + uid + ')">';
  SERIES_DEF.forEach(function(sd, k){
    var items = MOIS_AXE.map(function(m, i){
      return by[m] ? {x: geo.cx(i), v: by[m][sd.cle], m: m, g: by[m]} : null;
    });
    segments(items).forEach(function(seg){
      var pts = seg.map(function(it){ return [it.x, y(it.v)]; });
      var line = monotone(pts);
      if (pts.length === 1){
        /* tronçon d'un seul mois : pas de courbe possible, le point suffit */
        return;
      }
      s += '<path class="series-area" d="' + line + 'L' + pts[pts.length - 1][0].toFixed(1) + ',' + baseY +
           'L' + pts[0][0].toFixed(1) + ',' + baseY + 'Z" fill="url(#ar' + uid + '-' + k + ')"/>';
      s += '<path class="series-line" d="' + line + '" stroke="' + sd.col + '"/>';
    });
    /* points : le dernier est renforcé */
    var live = items.filter(Boolean);
    live.forEach(function(it, j){
      var last = j === live.length - 1;
      s += '<circle class="' + (last ? 'dot-end' : 'dot') + ' pop" cx="' + it.x.toFixed(1) + '" cy="' + y(it.v).toFixed(1) +
           '" r="' + (last ? 5.4 : 4) + '" fill="' + sd.col + '" style="animation-delay:' + (0.36 + j * 0.075).toFixed(2) + 's"/>';
    });
  });
  s += '</g>';

  /* étiquettes directes en bout de courbe, hors du balayage */
  SERIES_DEF.forEach(function(sd) {
    var live = MOIS_AXE.map(function(m, i){ return by[m] ? {x: geo.cx(i), v: by[m][sd.cle]} : null; }).filter(Boolean);
    if (!live.length) return;
    var it = live[live.length - 1];
    s += '<g class="fade" style="animation-delay:.95s">' +
         '<text class="endlabel" x="' + (it.x + 11).toFixed(1) + '" y="' + (y(it.v) - 4).toFixed(1) + '" fill="' + sd.col + '">' + esc(sd.lab) + '</text>' +
         '<text class="endlabel endlabel--val" x="' + (it.x + 11).toFixed(1) + '" y="' + (y(it.v) + 10).toFixed(1) + '">' + fShort(it.v) + '</text></g>';
  });

  s += '<line class="axis-line" x1="' + GEO.padL + '" y1="' + baseY + '" x2="' + (GEO.W - GEO.padR) + '" y2="' + baseY + '"/>';
  s += moisAxis(by, geo, baseY, true);

  /* tranches de survol : croix de lecture + points renforcés + infobulle */
  MOIS_AXE.forEach(function(m, i){
    var g = by[m]; if (!g) return;
    var cx = geo.cx(i);
    s += '<g class="slot" data-tip="' + moisTip(m, g) + '">' +
         '<line class="xhair" x1="' + cx.toFixed(1) + '" y1="' + GEO.padT + '" x2="' + cx.toFixed(1) + '" y2="' + baseY + '"/>' +
         SERIES_DEF.map(function(sd){
           return '<circle class="dot-hi" cx="' + cx.toFixed(1) + '" cy="' + y(g[sd.cle]).toFixed(1) +
                  '" r="6.4" fill="' + sd.col + '" stroke="var(--surface)" stroke-width="2.5"/>';
         }).join('') +
         '<rect class="hit" x="' + (cx - geo.slot / 2).toFixed(1) + '" y="' + GEO.padT + '" width="' + geo.slot.toFixed(1) +
         '" height="' + ih + '"/></g>';
  });

  document.getElementById('ch-mois').innerHTML =
    '<svg class="chart" viewBox="0 0 ' + GEO.W + ' ' + H + '" role="img" aria-label="Courbes de couverture et de vues par mois, janvier à août 2026">' + s + '</svg>';
}

/* ---------- vue barres groupées (miroir du tableau « Synthèse ») ---------- */
function renderMoisBarres(rows){
  var by = moisIndex(rows), geo = moisGeo();
  var H = 330, ih = H - GEO.padT - GEO.padB, baseY = GEO.padT + ih;
  var max = niceMax(Math.max.apply(null, MOIS_AXE.map(function(m){
    return by[m] ? Math.max(by[m].couv, by[m].vues) : 0;
  }).concat([1])));
  var gw = Math.min(geo.slot * 0.6, 72), bw = (gw - 2) / 2;
  var y = function(v){ return GEO.padT + ih - (v / max) * ih; };
  var s = '';
  ticks(max, 4).forEach(function(tv){
    s += '<line class="tick-line" x1="' + GEO.padL + '" y1="' + y(tv).toFixed(1) + '" x2="' + (GEO.W - GEO.padR) + '" y2="' + y(tv).toFixed(1) + '"/>';
    s += '<text class="tick-label" x="' + (GEO.padL - 9) + '" y="' + (y(tv) + 3.4).toFixed(1) + '" text-anchor="end">' + (tv === 0 ? '0' : fShort(tv)) + '</text>';
  });
  var maxVues = Math.max.apply(null, MOIS_AXE.map(function(m){ return by[m] ? by[m].vues : 0; }));
