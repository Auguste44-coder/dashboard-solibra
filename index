           '" text-anchor="middle" style="animation-delay:.6s">' + fShort(g.vues) + '</text>';
  });
  s += '<line class="axis-line" x1="' + GEO.padL + '" y1="' + baseY + '" x2="' + (GEO.W - GEO.padR) + '" y2="' + baseY + '"/>';
  s += moisAxis(by, geo, baseY, true);
  document.getElementById('ch-mois').innerHTML =
    '<svg class="chart" viewBox="0 0 ' + GEO.W + ' ' + H + '" role="img" aria-label="Couverture et vues par mois, janvier à août 2026">' + s + '</svg>';
}

/* ---------- bande budget, échelle propre, aligné sur l'axe des mois ---------- */
function renderMoisBudget(rows){
  var by = moisIndex(rows), geo = moisGeo();
  var Hb = 116, padTb = 24, ihb = Hb - padTb - 22, baseY = padTb + ihb;
  var maxB = niceMax(Math.max.apply(null, MOIS_AXE.map(function(m){ return by[m] ? by[m].budget : 0; }).concat([1])));
  var yb = function(v){ return padTb + ihb - (v / maxB) * ihb; };
  var budgetTotal = agg(rows).budget || 1;
  var gw = Math.min(geo.slot * 0.6, 72);
  var b = '<text class="tick-label" x="' + GEO.padL + '" y="11" fill="var(--ink-2)" letter-spacing="1.3">BUDGET INVESTI (€)</text>';
  [0, maxB].forEach(function(tv){
    b += '<line class="tick-line" x1="' + GEO.padL + '" y1="' + yb(tv).toFixed(1) + '" x2="' + (GEO.W - GEO.padR) + '" y2="' + yb(tv).toFixed(1) + '"/>';
