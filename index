<title>Boost Meta SOLIBRA 2026</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Source+Sans+3:wght@400;600&family=IBM+Plex+Mono:wght@500&display=swap">
<style>
/* ============================== TOKENS ============================== */
:root{
  color-scheme: light;
  --ground:#efebe6; --surface:#ffffff; --surface-2:#f7f4f1; --surface-3:#eae4de;
  --ink:#1f1a17; --ink-2:#6b6157; --ink-3:#968c83;
  --line:#ded7d0; --line-soft:#ebe5df; --line-strong:#c9bdb2;
  --rouge:#ca0030; --ambre:#b3900f; --sarcelle:#007c9e;
  --rouge-wash:#fdeff2;
  --shadow:0 1px 2px rgba(31,26,23,.05), 0 8px 24px -14px rgba(31,26,23,.18);
  --shadow-lift:0 1px 2px rgba(31,26,23,.06), 0 16px 38px -18px rgba(31,26,23,.26);
  --focus:#007c9e;
  --grid:#e7e1db; --axis:#cbc3bb;
  --font-display:'Archivo',system-ui,'Segoe UI',sans-serif;
  --font-body:'Source Sans 3',system-ui,'Segoe UI',sans-serif;
  --font-mono:'IBM Plex Mono',ui-monospace,Consolas,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme: dark;
    --ground:#14100e; --surface:#1a1614; --surface-2:#221d1a; --surface-3:#2d2723;
    --ink:#f5f1ed; --ink-2:#b6aba1; --ink-3:#8a7f76;
    --line:#332c27; --line-soft:#262020; --line-strong:#4a3f38;
    --rouge:#e63a60; --ambre:#b4900a; --sarcelle:#1e8ca8;
    --rouge-wash:#2a1218;
    --shadow:0 1px 2px rgba(0,0,0,.4), 0 10px 30px -16px rgba(0,0,0,.8);
    --shadow-lift:0 1px 2px rgba(0,0,0,.45), 0 18px 44px -18px rgba(0,0,0,.9);
    --focus:#4fb3cc;
    --grid:#2c2521; --axis:#403830;
  }
}
:root[data-theme="dark"]{
  color-scheme: dark;
  --ground:#14100e; --surface:#1a1614; --surface-2:#221d1a; --surface-3:#2d2723;
  --ink:#f5f1ed; --ink-2:#b6aba1; --ink-3:#8a7f76;
  --line:#332c27; --line-soft:#262020; --line-strong:#4a3f38;
  --rouge:#e63a60; --ambre:#b4900a; --sarcelle:#1e8ca8;
  --rouge-wash:#2a1218;
  --shadow:0 1px 2px rgba(0,0,0,.4), 0 10px 30px -16px rgba(0,0,0,.8);
  --shadow-lift:0 1px 2px rgba(0,0,0,.45), 0 18px 44px -18px rgba(0,0,0,.9);
  --focus:#4fb3cc;
  --grid:#2c2521; --axis:#403830;
}

*{box-sizing:border-box}
body{
  background:var(--ground); color:var(--ink);
  font-family:var(--font-body); font-size:15px; line-height:1.55;
  -webkit-font-smoothing:antialiased;
}
:focus-visible{outline:2px solid var(--focus); outline-offset:2px; border-radius:3px}

/* ============================== MOUVEMENT ==============================
   Un seul interrupteur : les délais sont remis à zéro en même temps que les
   durées, sinon un élément en animation-fill-mode:both resterait invisible
   pendant son délai pour qui a désactivé les animations. */
@media (prefers-reduced-motion: reduce){
  *, *::before, *::after{
    animation-duration:1ms !important; animation-delay:0s !important;
    transition-duration:1ms !important; transition-delay:0s !important;
  }
}
@keyframes fadeRise{from{opacity:0; transform:translateY(9px)} to{opacity:1; transform:none}}
@keyframes fadeIn{from{opacity:0} to{opacity:1}}
@keyframes growH{from{transform:scaleX(0)} to{transform:scaleX(1)}}
@keyframes growV{from{transform:scaleY(0)} to{transform:scaleY(1)}}
@keyframes popIn{from{opacity:0; transform:scale(.35)} to{opacity:1; transform:scale(1)}}

/* Toute la séquence d'entrée est bornée : le dernier élément a fini avant
   1,15 s, qu'on ait défilé ou non. Rien n'attend un IntersectionObserver. */
.anim-rise{animation:fadeRise .55s cubic-bezier(.2,.7,.3,1) both}
.grow-h{transform-box:fill-box; transform-origin:left center; animation:growH .68s cubic-bezier(.16,.84,.44,1) both}
.grow-v{transform-box:fill-box; transform-origin:bottom center; animation:growV .68s cubic-bezier(.16,.84,.44,1) both}
.pop{transform-box:fill-box; transform-origin:center; animation:popIn .34s cubic-bezier(.2,1.35,.4,1) both}
.fade{animation:fadeIn .5s ease-out both}
.shell{max-width:1300px; margin:0 auto; padding:0 clamp(14px,3vw,34px)}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}

/* ============================== MASTHEAD ============================== */
.masthead{background:var(--surface); border-bottom:1px solid var(--line)}
.masthead__inner{display:flex; align-items:center; gap:clamp(14px,2.4vw,26px); padding:16px 0; flex-wrap:wrap}
.seal{width:60px; height:60px; flex:0 0 auto; border-radius:50%; background:#fff; padding:2px; box-shadow:0 0 0 1px var(--line)}
.seal img{display:block; width:100%; height:100%}
.masthead__id{min-width:0}
.wordmark{font-family:var(--font-display); font-weight:700; font-size:25px; line-height:1.05; letter-spacing:.035em; margin:0}
.wordmark em{font-style:normal; color:var(--rouge)}
.masthead__sub{font-family:var(--font-mono); font-size:10px; font-weight:500; letter-spacing:.15em; text-transform:uppercase; color:var(--ink-2); margin:6px 0 0}
.masthead__meta{display:flex; gap:26px; margin-left:auto; flex-wrap:wrap}
.mm{display:flex; flex-direction:column; gap:3px}
.mm__k{font-family:var(--font-mono); font-size:9px; font-weight:500; letter-spacing:.13em; text-transform:uppercase; color:var(--ink-3)}
.mm__v{font-family:var(--font-display); font-weight:600; font-size:14px; color:var(--ink)}
.mm__v a{color:var(--rouge); text-decoration:none; border-bottom:1px solid transparent}
.mm__v a:hover{border-bottom-color:var(--rouge)}

/* ============================== TITLE ============================== */
.titleblock{padding:34px 0 0}
.eyebrow{font-family:var(--font-mono); font-size:10px; font-weight:500; letter-spacing:.17em; text-transform:uppercase; color:var(--rouge); display:flex; align-items:center; gap:10px}
.eyebrow::after{content:''; flex:1; height:1px; background:var(--line); max-width:140px}
.titleblock h2{font-family:var(--font-display); font-weight:700; font-size:clamp(27px,4.2vw,41px); line-height:1.07; letter-spacing:-.02em; margin:13px 0 0; text-wrap:balance; max-width:24ch}
.titleblock p{max-width:66ch; color:var(--ink-2); margin:13px 0 0; font-size:15.5px}

/* ============================== FILTERS ============================== */
.filterbar{position:sticky; top:0; z-index:40; background:var(--ground); border-top:1px solid var(--line); border-bottom:1px solid var(--line); margin-top:26px}
.filterbar__inner{display:flex; align-items:flex-end; gap:12px 18px; flex-wrap:wrap; padding:11px 0}
.field{display:flex; flex-direction:column; gap:5px; min-width:0}
.field > span{font-family:var(--font-mono); font-size:9px; font-weight:500; letter-spacing:.13em; text-transform:uppercase; color:var(--ink-3)}
.field select{
  font-family:var(--font-body); font-size:14px; color:var(--ink);
  background-color:var(--surface); border:1px solid var(--line); border-radius:6px;
  padding:7px 30px 7px 10px; min-width:150px; cursor:pointer; appearance:none;
  background-image:linear-gradient(45deg,transparent 50%,currentColor 50%),linear-gradient(135deg,currentColor 50%,transparent 50%);
  background-position:calc(100% - 16px) 53%, calc(100% - 11px) 53%;
  background-size:5px 5px,5px 5px; background-repeat:no-repeat;
}
.field select:hover{border-color:var(--ink-3)}
.btn-ghost{font-family:var(--font-mono); font-size:10px; letter-spacing:.1em; text-transform:uppercase; background:none; border:1px solid var(--line); border-radius:6px; color:var(--ink-2); padding:8px 12px; cursor:pointer}
.btn-ghost:hover{border-color:var(--rouge); color:var(--rouge)}
.filter-count{margin-left:auto; font-family:var(--font-mono); font-size:11px; letter-spacing:.05em; color:var(--ink-2); padding-bottom:8px; white-space:nowrap}
.filter-count b{color:var(--rouge); font-size:13.5px}

/* ============================== KPI STRIP ============================== */
.kpis{display:grid; grid-template-columns:repeat(5,1fr); background:var(--surface); border:1px solid var(--line); border-radius:10px; margin-top:26px; overflow:hidden; box-shadow:var(--shadow)}
.kpi{padding:17px 19px 19px; border-left:1px solid var(--line-soft); min-width:0}
.kpi:first-child{border-left:0}
.kpi--lead{background:var(--rouge-wash)}
.kpi__label{font-family:var(--font-mono); font-size:9px; font-weight:500; letter-spacing:.13em; text-transform:uppercase; color:var(--ink-2); display:block; margin-bottom:9px}
.kpi__val{font-family:var(--font-display); font-weight:700; font-size:clamp(23px,2.8vw,33px); line-height:1; letter-spacing:-.022em; font-variant-numeric:tabular-nums; display:block}
.kpi--lead .kpi__val{color:var(--rouge)}
.kpi__unit{font-size:.48em; font-weight:600; color:var(--ink-2); letter-spacing:0; margin-left:3px}
.kpi__note{font-family:var(--font-mono); font-size:9.5px; color:var(--ink-3); letter-spacing:.04em; margin-top:9px; display:block}
.kpis--derived{grid-template-columns:repeat(3,1fr); margin-top:10px}
.kpis--derived .kpi__val{font-size:clamp(19px,2.1vw,25px)}
@media (max-width:1040px){
  .kpis{grid-template-columns:repeat(2,1fr)}
  .kpi{border-top:1px solid var(--line-soft)}
  .kpi:nth-child(-n+2){border-top:0}
  .kpi:nth-child(odd){border-left:0}
  .kpis--derived{grid-template-columns:repeat(3,1fr)}
  .kpis--derived .kpi{border-top:0; border-left:1px solid var(--line-soft)}
  .kpis--derived .kpi:first-child{border-left:0}
}
@media (max-width:640px){
  .kpis, .kpis--derived{grid-template-columns:1fr}
  .kpis .kpi, .kpis--derived .kpi{border-left:0; border-top:1px solid var(--line-soft)}
  .kpis .kpi:first-child, .kpis--derived .kpi:first-child{border-top:0}
}

/* ============================== SECTIONS ============================== */
.section{margin-top:46px}
.section__head{display:flex; align-items:flex-end; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:15px}
.section__head h3{font-family:var(--font-display); font-weight:600; font-size:clamp(19px,2.2vw,25px); letter-spacing:-.012em; margin:9px 0 0; text-wrap:balance}
.section__note{font-size:13.5px; color:var(--ink-2); max-width:58ch; margin:6px 0 0}
.panel{background:var(--surface); border:1px solid var(--line); border-radius:10px; padding:19px clamp(14px,1.9vw,22px) 17px; box-shadow:var(--shadow);
       transition:border-color .3s ease, box-shadow .3s ease}
.panel:hover{border-color:var(--line-strong); box-shadow:var(--shadow-lift)}
.panel__title{font-family:var(--font-mono); font-size:10px; font-weight:500; letter-spacing:.13em; text-transform:uppercase; color:var(--ink-2); margin:0}
.panel__sub{font-size:12.5px; color:var(--ink-3); margin:4px 0 0}
.panel__hd{display:flex; align-items:flex-start; justify-content:space-between; gap:14px; flex-wrap:wrap; margin-bottom:16px}
.grid-2{display:grid; grid-template-columns:1fr 1fr; gap:16px}
@media (max-width:880px){ .grid-2{grid-template-columns:1fr} }
.stack{display:flex; flex-direction:column; gap:22px}

/* ============================== CHARTS ============================== */
.chart{width:100%; display:block; height:auto}
.chart text{font-family:var(--font-mono)}
.tick-line{stroke:var(--grid); stroke-width:1}
.axis-line{stroke:var(--axis); stroke-width:1}
.tick-label{font-size:9px; letter-spacing:.03em; fill:var(--ink-3)}
.cat-label{font-size:10.5px; fill:var(--ink-2); letter-spacing:.015em}
.cat-label--strong{fill:var(--ink); font-size:11px}
.val-label{font-size:10.5px; fill:var(--ink); letter-spacing:.02em}
.mark{transition:opacity .12s}
.mark:hover{opacity:.78}

/* ---------- courbes ---------- */
.series-line{fill:none; stroke-width:2; stroke-linecap:round; stroke-linejoin:round}
.series-area{stroke:none}
.dot{stroke:var(--surface); stroke-width:2}
.dot-end{stroke:var(--surface); stroke-width:2.5}
.endlabel{font-size:10px; letter-spacing:.03em; fill:var(--ink-2)}
.endlabel--val{font-size:11.5px; fill:var(--ink)}
/* Repère de lecture : croix + points renforcés, révélés au survol de la tranche */
.slot .xhair{stroke:var(--axis); stroke-width:1; stroke-dasharray:3 3; opacity:0; transition:opacity .13s}
.slot .dot-hi{opacity:0; transition:opacity .13s}
.slot:hover .xhair, .slot:hover .dot-hi{opacity:1}
.slot .hit{fill:transparent}
.gapmark{font-size:9px; letter-spacing:.08em; fill:var(--ink-3)}

/* ---------- sparklines des chiffres clés ---------- */
.spark{display:block; width:100%; height:auto; margin-top:11px; overflow:visible}
.spark-line{fill:none; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round}
.spark-area{stroke:none; opacity:.16}
.spark-end{stroke:var(--surface); stroke-width:1.6}
.kpi--lead .spark-end{stroke:var(--rouge-wash)}
.legend{display:flex; gap:16px; flex-wrap:wrap; align-items:center; margin:0}
.legend__item{display:flex; align-items:center; gap:7px; font-size:12.5px; color:var(--ink-2); white-space:nowrap}
.legend__swatch{width:11px; height:11px; border-radius:3px; flex:0 0 auto}
.tooltip{position:fixed; z-index:90; pointer-events:none; opacity:0; transition:opacity .1s; background:var(--ink); color:var(--ground); border-radius:7px; padding:9px 11px; font-size:12.5px; line-height:1.45; max-width:300px; box-shadow:0 8px 26px -8px rgba(0,0,0,.5)}
.tooltip[data-on="1"]{opacity:1}
.tooltip strong{font-family:var(--font-display); font-weight:600; display:block; margin-bottom:4px; font-size:13px}
.tooltip .tt-row{display:flex; justify-content:space-between; gap:14px; font-size:11.5px}
.tooltip .tt-k{opacity:.72}
.tooltip .tt-v{font-family:var(--font-mono); font-variant-numeric:tabular-nums}

/* ============================== TOGGLES ============================== */
.toggles{display:flex; gap:3px; flex-wrap:wrap; background:var(--surface-2); padding:3px; border-radius:8px; border:1px solid var(--line-soft)}
.toggles button{font-family:var(--font-mono); font-size:9.5px; letter-spacing:.09em; text-transform:uppercase; background:none; border:0; color:var(--ink-2); padding:6px 9px; border-radius:6px; cursor:pointer}
.toggles button:hover{color:var(--ink)}
.toggles button[aria-pressed="true"]{background:var(--surface); color:var(--rouge); box-shadow:0 1px 2px rgba(0,0,0,.09)}

/* ============================== TABLES ============================== */
.tablewrap{overflow-x:auto; border:1px solid var(--line); border-radius:10px; background:var(--surface); box-shadow:var(--shadow)}
table.data{width:100%; border-collapse:collapse; font-size:13.5px; min-width:760px}
table.data th, table.data td{padding:9px 12px; text-align:right; white-space:nowrap}
table.data th:first-child, table.data td:first-child{text-align:left}
table.data thead th{font-family:var(--font-mono); font-size:9px; font-weight:500; letter-spacing:.1em; text-transform:uppercase; color:var(--ink-2); background:var(--surface-2); border-bottom:1px solid var(--line)}
table.data thead th.sortable{cursor:pointer; user-select:none}
table.data thead th.sortable:hover{color:var(--rouge)}
table.data thead th.is-sorted{color:var(--rouge)}
table.data tbody td{border-bottom:1px solid var(--line-soft); font-variant-numeric:tabular-nums}
table.data tbody tr:last-child td{border-bottom:0}
table.data tbody tr:hover td{background:var(--surface-2)}
table.data tfoot td{border-top:1px solid var(--line); font-family:var(--font-display); font-weight:600; font-variant-numeric:tabular-nums; background:var(--surface-2); color:var(--ink)}
.cell-name{font-family:var(--font-display); font-weight:600; color:var(--ink)}

/* --- pastilles de marque (logos fournis par SOLIBRA, cercles à fond transparent) --- */
.namecell{display:flex; align-items:center; gap:10px; min-width:0}
.namecell--end{justify-content:flex-end}
.glyph{flex:0 0 auto; display:block}
.legend__item .glyph{margin-right:-1px}
.blogo{border-radius:50%; flex:0 0 auto; display:block; object-fit:contain;
       box-shadow:0 0 0 1px var(--line); background:var(--surface-2)}
.blogo--md{width:26px; height:26px}
.blogo--sm{width:20px; height:20px}
.brandflag{display:flex; align-items:center; gap:14px; margin:20px 0 0;
           background:var(--surface); border:1px solid var(--line); border-radius:10px;
           padding:12px 16px; box-shadow:var(--shadow); max-width:max-content}
.brandflag img{width:46px; height:46px; border-radius:50%; box-shadow:0 0 0 1px var(--line); background:var(--surface-2)}
.brandflag__n{font-family:var(--font-display); font-weight:700; font-size:19px; letter-spacing:-.01em; line-height:1.15}
.brandflag__c{font-family:var(--font-mono); font-size:9.5px; letter-spacing:.13em; text-transform:uppercase; color:var(--ink-2); margin-top:3px}
.barcell{display:flex; align-items:center; gap:9px; justify-content:flex-end}
.barcell__track{width:70px; height:7px; background:var(--surface-3); border-radius:4px; overflow:hidden; flex:0 0 auto}
.barcell__fill{height:100%; background:var(--rouge); border-radius:4px}
.barcell__num{min-width:46px; text-align:right}
.chip{display:inline-block; font-family:var(--font-mono); font-size:8.5px; letter-spacing:.09em; text-transform:uppercase; padding:2px 6px; border-radius:4px; border:1px solid var(--line); color:var(--ink-2); background:var(--surface-2); margin-left:8px; vertical-align:1px; white-space:nowrap}
.postlink{color:var(--sarcelle); text-decoration:none; border-bottom:1px solid transparent; font-size:12.5px; font-family:var(--font-mono)}
.postlink:hover{border-bottom-color:var(--sarcelle)}
.nolink{color:var(--ink-3); font-family:var(--font-mono); font-size:10.5px}
.rank{font-family:var(--font-mono); font-size:11px; color:var(--ink-3); display:inline-block; min-width:22px}
.searchrow{display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:12px}
.searchrow input{font-family:var(--font-body); font-size:14px; color:var(--ink); background:var(--surface); border:1px solid var(--line); border-radius:6px; padding:8px 12px; flex:1 1 240px; max-width:400px}
.searchrow input::placeholder{color:var(--ink-3)}
.tablefoot{font-family:var(--font-mono); font-size:10px; color:var(--ink-3); letter-spacing:.05em; margin-top:11px; display:flex; gap:16px; flex-wrap:wrap; align-items:center}

/* ============================== NOTES ============================== */
.caveat{display:flex; gap:11px; align-items:flex-start; border-left:3px solid var(--ambre); background:var(--surface-2); padding:12px 14px; border-radius:0 8px 8px 0; margin:0 0 16px; font-size:13.5px; color:var(--ink-2)}
.caveat strong{color:var(--ink); font-weight:600}
.empty{text-align:center; padding:40px 20px; color:var(--ink-3); font-size:14px; background:var(--surface); border:1px dashed var(--line); border-radius:10px}
.method{margin:54px 0 0; padding:26px 0 48px; border-top:1px solid var(--line); display:grid; grid-template-columns:1.05fr 1fr; gap:28px 44px}
@media (max-width:780px){ .method{grid-template-columns:1fr} }
.method h4{font-family:var(--font-mono); font-size:10px; font-weight:500; letter-spacing:.13em; text-transform:uppercase; color:var(--ink-2); margin:0 0 11px}
.method ul{margin:0; padding-left:18px; color:var(--ink-2); font-size:13.5px}
.method li{margin-bottom:8px}
.method li strong{color:var(--ink); font-weight:600}
.defs{display:grid; grid-template-columns:auto 1fr; gap:7px 14px; margin:0; font-size:13.5px}
.defs dt{font-family:var(--font-display); font-weight:600; color:var(--ink); white-space:nowrap}
.defs dd{margin:0; color:var(--ink-2)}
.credit{font-family:var(--font-mono); font-size:9.5px; letter-spacing:.09em; text-transform:uppercase; color:var(--ink-3); grid-column:1/-1; padding-top:16px; border-top:1px solid var(--line-soft); display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap}
.credit a{color:var(--ink-2); text-decoration:none}
.credit a:hover{color:var(--rouge)}
</style>

<!-- Dégradé officiel Instagram, défini une fois et référencé par les glyphes -->
<svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
  <defs>
    <linearGradient id="ig-grad" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0%" stop-color="#FEDA75"/>
      <stop offset="25%" stop-color="#FA7E1E"/>
      <stop offset="50%" stop-color="#D62976"/>
      <stop offset="75%" stop-color="#962FBF"/>
      <stop offset="100%" stop-color="#4F5BD5"/>
    </linearGradient>
  </defs>
</svg>

<header class="masthead">
  <div class="shell masthead__inner">
    <div class="seal"><img src="data:image/png;base64," alt="Sceau Qualité SOLIBRA" width="120" height="120"></div>
    <div class="masthead__id">
      <p class="wordmark">SOLI<em>BRA</em></p>
      <p class="masthead__sub">Bières · Vins · Boissons gazeuses — Côte d&rsquo;Ivoire</p>
    </div>
    <div class="masthead__meta">
