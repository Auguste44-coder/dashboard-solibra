/* segment de barre empilée : coins arrondis seulement à l'extrémité terminale */
function segH(x, y, w, h, rStart, rEnd){
  if (w <= 0.4) return '';
  var r1 = Math.min(rStart, h / 2, w / 2), r2 = Math.min(rEnd, h / 2, w / 2);
  return 'M' + (x + r1) + ',' + y +
         'L' + (x + w - r2) + ',' + y +
         (r2 ? 'Q' + (x + w) + ',' + y + ' ' + (x + w) + ',' + (y + r2) : 'L' + (x + w) + ',' + y) +
         'L' + (x + w) + ',' + (y + h - r2) +
         (r2 ? 'Q' + (x + w) + ',' + (y + h) + ' ' + (x + w - r2) + ',' + (y + h) : '') +
         'L' + (x + r1) + ',' + (y + h) +
         (r1 ? 'Q' + x + ',' + (y + h) + ' ' + x + ',' + (y + h - r1) : 'L' + x + ',' + (y + h)) +
         'L' + x + ',' + (y + r1) +
         (r1 ? 'Q' + x + ',' + y + ' ' + (x + r1) + ',' + y : '') + 'Z';
}
/* Construit l'infobulle en HTML, puis échappe une seule fois pour l'attribut data-tip.
   getAttribute() rend le HTML décodé, que le gestionnaire réinjecte via innerHTML. */
/* Spline cubique monotone (Fritsch–Carlson) : suit les points sans jamais
   créer de creux ou de bosse entre deux valeurs — un dépassement sous zéro
   sur des volumes de couverture n'aurait aucun sens. */
function monotone(pts){
  var n = pts.length;
  if (n === 0) return '';
  if (n === 1) return 'M' + pts[0][0] + ',' + pts[0][1];
  if (n === 2) return 'M' + pts[0][0] + ',' + pts[0][1] + 'L' + pts[1][0] + ',' + pts[1][1];
  var dx = [], dy = [], m = [], i;
  for (i = 0; i < n - 1; i++){
    dx[i] = pts[i + 1][0] - pts[i][0];
    dy[i] = pts[i + 1][1] - pts[i][1];
    m[i] = dx[i] === 0 ? 0 : dy[i] / dx[i];
  }
  var t = [m[0]];
  for (i = 1; i < n - 1; i++){
    if (m[i - 1] * m[i] <= 0) t[i] = 0;
    else {
      var w1 = 2 * dx[i] + dx[i - 1], w2 = dx[i] + 2 * dx[i - 1];
      t[i] = (w1 + w2) / (w1 / m[i - 1] + w2 / m[i]);
    }
  }
  t[n - 1] = m[n - 2];
  var d = 'M' + pts[0][0].toFixed(1) + ',' + pts[0][1].toFixed(1);
  for (i = 0; i < n - 1; i++){
    var x0 = pts[i][0], y0 = pts[i][1], x1 = pts[i + 1][0], y1 = pts[i + 1][1], h = dx[i] / 3;
    d += 'C' + (x0 + h).toFixed(1) + ',' + (y0 + t[i] * h).toFixed(1) +
         ' ' + (x1 - h).toFixed(1) + ',' + (y1 - t[i + 1] * h).toFixed(1) +
         ' ' + x1.toFixed(1) + ',' + y1.toFixed(1);
  }
  return d;
}
/* Découpe une série en tronçons continus : mars 2026 n'a aucune publication,
   la courbe doit s'interrompre au lieu d'enjamber le trou. */
function segments(items){
  var out = [], cur = [];
  items.forEach(function(it){
    if (it) cur.push(it);
    else if (cur.length){ out.push(cur); cur = []; }
  });
  if (cur.length) out.push(cur);
  return out;
}
var UID = 0;

function tip(title, rows){
  var h = '<strong>' + title + '</strong>';
  for (var i = 0; i < rows.length; i++)
    h += '<span class="tt-row"><span class="tt-k">' + rows[i][0] + '</span><span class="tt-v">' + rows[i][1] + '</span></span>';
  return esc(h);
}
/* items : [libellé, couleur] — ou [libellé, couleur, canal] pour ajouter la marque
   officielle de la plateforme après le carré de série. Le carré reste : lui seul
   relie la légende aux couleurs des barres, que le logo ne porte plus. */
function legend(el, items){
  document.getElementById(el).innerHTML = items.map(function(it){
    var mark = '<span class="legend__swatch" style="background:' + it[1] + '"></span>';
    if (it[2] && GLYPHES[it[2]]) mark += glyph(it[2], 17);
    return '<span class="legend__item">' + mark + esc(it[0]) + '</span>';
  }).join('');
}

