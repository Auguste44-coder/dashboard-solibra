/* ======================= BARRES HORIZONTALES CLASSÉES ======================= */
var METRIQUES = {
  budget: {lab:'Budget',            get:function(g){return g.budget;}, fmt:fEur,   short:function(v){return fInt(v) + ' €';}},
  couv:   {lab:'Couverture',        get:function(g){return g.couv;},   fmt:fInt,   short:fShort},
  vues:   {lab:'Vues / impr.',      get:function(g){return g.vues;},   fmt:fInt,   short:fShort},
  inter:  {lab:'Interactions',      get:function(g){return g.inter;},  fmt:fInt,   short:fShort},
  n:      {lab:'Publications',      get:function(g){return g.n;},      fmt:fInt,   short:fInt},
  eng:    {lab:'Taux d’engag.',get:function(g){return g.eng||0;}, fmt:fPct,   short:fPct1},
  cpi:    {lab:'Coût / interaction',get:function(g){return g.cpi||0;}, fmt:fCost,  short:function(v){return v.toLocaleString('fr-FR',{minimumFractionDigits:3,maximumFractionDigits:3}) + ' €';}}
};
function rankedBars(target, groups, metricKey, labelW, sub, withLogos){
  var mt = METRIQUES[metricKey];
  groups = groups.slice().sort(function(a, b){ return mt.get(b) - mt.get(a); });
  var W = 1000, rowH = withLogos ? 34 : 30, padT = 6, padB = 8, padR = 92;
  var H = padT + groups.length * rowH + padB;
  var iw = W - labelW - padR;
  var max = Math.max.apply(null, groups.map(mt.get).concat([0.0000001]));
  var LG = 24, textX = withLogos ? LG + 10 : 0;
  var s = '';
  groups.forEach(function(g, i){
    var y = padT + i * rowH, v = mt.get(g), w = (v / max) * iw;
    var tp = tip(g.key + (sub && sub[g.key] ? ' — ' + sub[g.key] : ''), [
      ['Publications', fInt(g.n)], ['Budget', fEur(g.budget)],
      ['Couverture', fInt(g.couv)], ['Vues / impr.', fInt(g.vues)],
      ['Interactions', fInt(g.inter)],
      ['Taux engag.', g.eng == null ? '—' : fPct(g.eng)],
      ['Coût / inter.', fCost(g.cpi)]
    ]);
    var cy = y + rowH / 2;
    if (withLogos && logoSrc(g.key)){
      s += '<image href="' + logoSrc(g.key) + '" x="0" y="' + (cy - LG / 2).toFixed(1) +
           '" width="' + LG + '" height="' + LG + '" preserveAspectRatio="xMidYMid meet"/>';
    }
    var dly = (i * 0.042).toFixed(3);
    s += '<text class="cat-label cat-label--strong" x="' + textX + '" y="' + (cy + 4).toFixed(1) + '">' + esc(g.key) + '</text>';
    s += '<path class="mark grow-h" d="' + barH(labelW, y + (rowH - 18) / 2, Math.max(w, 0), 18) +
         '" fill="var(--rouge)" data-tip="' + tp + '" style="animation-delay:' + dly + 's"/>';
    s += '<text class="val-label fade" x="' + (labelW + Math.max(w, 0) + 9).toFixed(1) + '" y="' + (cy + 4).toFixed(1) +
         '" style="animation-delay:' + (0.3 + i * 0.042).toFixed(3) + 's">' + mt.short(v) + '</text>';
  });
  s += '<line class="axis-line" x1="' + labelW + '" y1="' + padT + '" x2="' + labelW + '" y2="' + (padT + groups.length * rowH) + '"/>';
  document.getElementById(target).innerHTML =
    '<svg class="chart" viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="Classement par ' + esc(mt.lab) + '">' + s + '</svg>';
}

/* ======================= BARRE DE PART (100 %) ======================= */
/* viewBox calé sur la largeur réelle du panneau demi-colonne (~560 px) :
   à l'échelle 1, les étiquettes gardent leur taille en points. */
function shareBars(target, series, groups, rowsDef){
  var W = 560, barH2 = 26, gap = 44, padT = 4, padL = 96, padR = 6;
  var H = padT + rowsDef.length * (barH2 + gap);
  var iw = W - padL - padR;
  var s = '';
  rowsDef.forEach(function(def, ri){
    var y = padT + ri * (barH2 + gap);
    var total = groups.reduce(function(a, g){ return a + def.get(g); }, 0) || 1;
    s += '<text class="cat-label cat-label--strong" x="0" y="' + (y + barH2 / 2 + 4) + '">' + esc(def.lab) + '</text>';
    var x = padL;
    /* Toute la barre est révélée d'un seul balayage : des segments qui
       grandiraient chacun depuis son propre bord se décolleraient les uns
       des autres pendant l'animation. */
    var uid = ++UID;
    s += '<defs><clipPath id="sh' + uid + '"><rect class="grow-h" x="' + padL + '" y="' + y + '" width="' + iw +
         '" height="' + barH2 + '" style="animation-delay:' + (ri * 0.12).toFixed(2) + 's"/></clipPath></defs>' +
         '<g clip-path="url(#sh' + uid + ')">';
    var labels = '';
    groups.forEach(function(g, gi){
      var v = def.get(g), w = (v / total) * iw;
      if (w <= 0) return;
      var isFirst = x <= padL + 0.5, isLast = (x + w) >= (padL + iw - 0.5);
      var wDraw = Math.max(w - 2, 1.5);
      s += '<path class="mark" d="' + segH(x, y, wDraw, barH2, isFirst ? 4 : 0, isLast ? 4 : 0) + '" fill="' + series[gi] + '" data-tip="' +
        tip(g.key, [[def.lab, def.fmt(v)], ['Part', fPct1(v / total)], ['Publications', fInt(g.n)]]) + '"/>';
      if (w > 46){
        var dl = (0.5 + ri * 0.12).toFixed(2);
        labels += '<text class="val-label fade" x="' + (x + wDraw / 2).toFixed(1) + '" y="' + (y + barH2 + 16) +
             '" text-anchor="middle" style="animation-delay:' + dl + 's">' + fPct1(v / total) + '</text>' +
             '<text class="tick-label fade" x="' + (x + wDraw / 2).toFixed(1) + '" y="' + (y + barH2 + 28) +
             '" text-anchor="middle" style="animation-delay:' + dl + 's">' + esc(def.short(v)) + '</text>';
      }
      x += w;
    });
    s += '</g>' + labels;
  });
  document.getElementById(target).innerHTML =
    '<svg class="chart" viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="Répartition en part du total">' + s + '</svg>';
}

/* ======================= ORGANIQUE / PAYANTE ======================= */
function renderOP(rows){
  var by = {};
  groupBy(rows, function(r){ return DATA.mois[r[MO]]; }).forEach(function(g){ by[g.key] = g; });
  var W = 1000, H = 250, padL = 66, padR = 14, padT = 22, padB = 38;
  var iw = W - padL - padR, ih = H - padT - padB;
  var max = niceMax(Math.max.apply(null, MOIS_AXE.map(function(m){
    return by[m] ? by[m].org + by[m].pay : 0;
  }).concat([1])));
  var slot = iw / MOIS_AXE.length, bw = Math.min(slot * 0.5, 54);
  var y = function(v){ return padT + ih - (v / max) * ih; };
  var s = '';
  ticks(max, 4).forEach(function(tv){
    s += '<line class="tick-line" x1="' + padL + '" y1="' + y(tv).toFixed(1) + '" x2="' + (W - padR) + '" y2="' + y(tv).toFixed(1) + '"/>';
    s += '<text class="tick-label" x="' + (padL - 9) + '" y="' + (y(tv) + 3.4).toFixed(1) + '" text-anchor="end">' + (tv === 0 ? '0' : fShort(tv)) + '</text>';
  });
  MOIS_AXE.forEach(function(m, i){
    var cx = padL + slot * i + slot / 2, g = by[m];
    s += '<text class="cat-label" x="' + cx.toFixed(1) + '" y="' + (padT + ih + 17) + '" text-anchor="middle">' + MOIS_COURT[m] + '</text>';
    if (!g) return;
    var x0 = cx - bw / 2, tot = g.org + g.pay;
    var tp = tip(MOIS_LONG[m], [
      ['Organique', fInt(g.org)], ['Payante', fInt(g.pay)],
      ['Total déclaré', fInt(tot)], ['Vues / impr. relevées', fInt(g.vues)]
    ]);
    var hPay = (padT + ih) - y(g.pay);
    var hOrg = (g.pay > 0 ? y(g.pay) : padT + ih) - y(tot);
    /* la pile entière grandit depuis sa base, d'un seul bloc : transform-box
       fill-box place déjà l'origine sur la boîte du groupe */
    s += '<g class="grow-v" style="animation-delay:' + (i * 0.055).toFixed(3) + 's">';
    s += '<path class="mark" d="' + barV(x0, y(g.pay), bw, hPay, 0) + '" fill="' + SERIES[1] + '" data-tip="' + tp + '"/>';
    if (hOrg > 0.4)
      s += '<path class="mark" d="' + barV(x0, y(tot), bw, Math.max(hOrg - 2, 0.5)) + '" fill="' + SERIES[2] + '" data-tip="' + tp + '"/>';
    s += '</g>';
  });
  s += '<line class="axis-line" x1="' + padL + '" y1="' + (padT + ih) + '" x2="' + (W - padR) + '" y2="' + (padT + ih) + '"/>';
  document.getElementById('ch-op').innerHTML =
    '<svg class="chart" viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="Vues organiques et payantes déclarées par mois">' + s + '</svg>';
}

/* ======================= TABLEAUX DE SYNTHÈSE ======================= */
function synthTable(target, dimLabel, groups, total, chips, withLogos, withGlyphs){
  var head = ['<tr><th>' + dimLabel + '</th><th>Publi.</th><th>Budget</th><th>% budget</th>' +
              '<th>Couverture</th><th>Vues / impr.</th><th>Interactions</th><th>Taux engag.</th><th>Coût / inter.</th></tr>'];
  var maxShare = Math.max.apply(null, groups.map(function(g){ return g.budget; }).concat([1]));
  var body = groups.map(function(g){
    var share = total.budget > 0 ? g.budget / total.budget : 0;
    var chipHtml = chips && chips[g.key] ? '<span class="chip">' + esc(chips[g.key]) + '</span>' : '';
    var firstCell = withLogos
      ? nameCell(g.key, 'md', chipHtml)
      : (withGlyphs && GLYPHES[g.key]
          ? '<span class="namecell">' + glyph(g.key, 18) +
            '<span><span class="cell-name">' + esc(g.key) + '</span>' + chipHtml + '</span></span>'
          : '<span class="cell-name">' + esc(g.key) + '</span>' + chipHtml);
    return '<tr><td>' + firstCell + '</td>' +
      '<td>' + fInt(g.n) + '</td>' +
      '<td>' + fEur(g.budget) + '</td>' +
      '<td><span class="barcell"><span class="barcell__track"><span class="barcell__fill" style="width:' +
        (g.budget / maxShare * 100).toFixed(1) + '%"></span></span><span class="barcell__num">' + fPct1(share) + '</span></span></td>' +
      '<td>' + fInt(g.couv) + '</td><td>' + fInt(g.vues) + '</td><td>' + fInt(g.inter) + '</td>' +
      '<td>' + (g.eng == null ? '—' : fPct(g.eng)) + '</td><td>' + fCost(g.cpi) + '</td></tr>';
  });
  var foot = '<tr><td>Total</td><td>' + fInt(total.n) + '</td><td>' + fEur(total.budget) + '</td><td>' +
    (total.budget > 0 ? '100,0 %' : '—') + '</td><td>' + fInt(total.couv) + '</td><td>' + fInt(total.vues) +
    '</td><td>' + fInt(total.inter) + '</td><td>' + (total.eng == null ? '—' : fPct(total.eng)) + '</td><td>' + fCost(total.cpi) + '</td></tr>';
  document.getElementById(target).innerHTML =
    '<thead>' + head.join('') + '</thead><tbody>' + body.join('') + '</tbody><tfoot>' + foot + '</tfoot>';
}

