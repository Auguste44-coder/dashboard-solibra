    ' sur ' + fInt(pool.length) + ' · trié par ' + col.lab.toLowerCase() + (state.allDir < 0 ? ' décroissant' : ' croissant');
  document.getElementById('all-more').style.display = pool.length > state.allLimit ? '' : 'none';
