    t.budget += r[BUD]; t.couv += r[COUV]; t.vues += r[VUES];
    t.likes += r[LIK]; t.com += r[COM]; t.part += r[PAR];
    t.org += r[ORG]; t.pay += r[PAY];
  }
  t.inter = t.likes + t.com + t.part;
  t.eng  = t.vues > 0 ? t.inter / t.vues : null;
  t.cpi  = t.inter > 0 ? t.budget / t.inter : null;
  t.cpm  = t.vues > 0 ? t.budget / (t.vues / 1000) : null;
  t.rep  = t.couv > 0 ? t.vues / t.couv : null;
  return t;
}
function groupBy(rows, keyFn){
  var map = new Map();
  for (var i = 0; i < rows.length; i++){
    var k = keyFn(rows[i]);
    if (!map.has(k)) map.set(k, []);
    map.get(k).push(rows[i]);
  }
  var out = [];
  map.forEach(function(v, k){ var a = agg(v); a.key = k; out.push(a); });
  return out;
}

