  {k:'cpi',    lab:'Coût / inter.',get:function(r){ return (r[LIK] + r[COM] + r[PAR]) > 0 ? r[BUD] / (r[LIK] + r[COM] + r[PAR]) : -1; }, num:true, fmt:function(v){ return v < 0 ? '—' : fCost(v); }},
