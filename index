/* ======================= RENDU GLOBAL ======================= */
function render(){
  var rows = filtered();
  var total = agg(rows);

  document.getElementById('f-count').innerHTML =
    '<b>' + fInt(rows.length) + '</b> publication' + (rows.length === 1 ? '' : 's') + ' sélectionnée' + (rows.length === 1 ? '' : 's');

  /* Marque isolée : son logo sert de repère d'état au-dessus des chiffres. */
  var flag = document.getElementById('brandflag');
  if (state.marque !== '*' && logoSrc(state.marque)){
    var iCat = DATA.marques.indexOf(state.marque);
    flag.className = 'brandflag';
    flag.innerHTML = '<img src="' + logoSrc(state.marque) + '" alt="">' +
      '<span><span class="brandflag__n">' + esc(state.marque) + '</span>' +
      '<span class="brandflag__c">' + esc(DATA.cat[iCat] || '') + ' · ' + fInt(rows.length) + ' publications</span></span>';
    flag.hidden = false;
  } else {
    flag.hidden = true;
    flag.innerHTML = '';
  }

  renderKPI(total, rows);

  if (!rows.length){
    ['ch-mois','ch-mois-budget','ch-marque','ch-cat','ch-canal','ch-format','ch-op'].forEach(function(id){
      document.getElementById(id).innerHTML = '<p class="empty">Aucune publication pour cette combinaison de filtres.</p>';
    });
    ['tb-marque','tb-canal','tb-format','tb-top','tb-all'].forEach(function(id){ document.getElementById(id).innerHTML = ''; });
    document.getElementById('all-foot').textContent = '';
    return;
  }

  renderMois(rows);

  var chips = {};
  DATA.marques.forEach(function(m, i){ chips[m] = DATA.cat[i]; });
  var gM = groupBy(rows, function(r){ return DATA.marques[r[M]]; });
  rankedBars('ch-marque', gM, state.metMarque, 200, chips, true);
  synthTable('tb-marque', 'Marque', gM.slice().sort(function(a, b){ return b.budget - a.budget; }), total, chips, true);

  var gCat = groupBy(rows, function(r){ return DATA.cat[r[M]]; });
  rankedBars('ch-cat', gCat, 'vues', 192);

  var gC = groupBy(rows, function(r){ return DATA.canaux[r[C]]; })
            .sort(function(a, b){ return DATA.canaux.indexOf(a.key) - DATA.canaux.indexOf(b.key); });
  /* Ordre fixe issu du fichier source : la couleur suit le canal / le format,
     jamais son rang — un filtre ne doit pas repeindre les survivants. */
  var gF = groupBy(rows, function(r){ return DATA.formats[r[F]]; })
            .sort(function(a, b){ return DATA.formats.indexOf(a.key) - DATA.formats.indexOf(b.key); });
  var shareDefs = [
    {lab:'Budget',       get:function(g){ return g.budget; }, fmt:fEur, short:function(v){ return fInt(v) + ' €'; }},
    {lab:'Vues / impr.', get:function(g){ return g.vues; },   fmt:fInt, short:fShort}
  ];
  var colC = gC.map(function(g){ return SERIES[DATA.canaux.indexOf(g.key) % SERIES.length]; });
  var colF = gF.map(function(g){ return SERIES[DATA.formats.indexOf(g.key) % SERIES.length]; });
  shareBars('ch-canal', colC, gC, shareDefs);
  shareBars('ch-format', colF, gF, shareDefs);
  legend('lg-canal', gC.map(function(g, i){ return [g.key, colC[i], g.key]; }));
  legend('lg-format', gF.map(function(g, i){ return [g.key, colF[i]]; }));
  synthTable('tb-canal', 'Canal', gC, total, null, false, true);
  synthTable('tb-format', 'Format', gF, total);

  renderOP(rows);
  renderTop(rows);
  renderAll(rows);
}

/* ======================= CONTRÔLES ======================= */
function fillSelect(id, values, allLabel){
  var el = document.getElementById(id);
  el.innerHTML = '<option value="*">' + allLabel + '</option>' +
    values.map(function(v){ return '<option value="' + esc(v) + '">' + esc(v) + '</option>'; }).join('');
}
(function init(){
  var marquesTri = DATA.marques.slice().sort(function(a, b){ return a.localeCompare(b, 'fr'); });
  var cats = DATA.cat.filter(function(v, i, a){ return a.indexOf(v) === i; }).sort();
  fillSelect('f-marque', marquesTri, 'Toutes les marques');
  fillSelect('f-cat', cats, 'Toutes catégories');
  fillSelect('f-canal', DATA.canaux.slice(), 'Tous les canaux');
  fillSelect('f-format', DATA.formats.slice().sort(), 'Tous les formats');
  var moisTri = DATA.mois.slice().sort();
  var el = document.getElementById('f-mois');
  el.innerHTML = '<option value="*">Toute la période</option>' +
    moisTri.map(function(m){ return '<option value="' + esc(m) + '">' + esc(MOIS_LONG[m] || m) + '</option>'; }).join('');

  [['f-marque','marque'], ['f-cat','cat'], ['f-canal','canal'], ['f-format','format'], ['f-mois','mois']]
    .forEach(function(p){
      document.getElementById(p[0]).addEventListener('change', function(){
        state[p[1]] = this.value; state.allLimit = 100; render();
      });
    });
  document.getElementById('f-reset').addEventListener('click', function(){
    state.marque = state.cat = state.canal = state.format = state.mois = '*';
    state.q = ''; state.allLimit = 100;
    ['f-marque','f-cat','f-canal','f-format','f-mois'].forEach(function(id){ document.getElementById(id).value = '*'; });
    document.getElementById('q-all').value = '';
    render();
  });

  var tgV = document.getElementById('tg-mois');
  tgV.innerHTML = [['courbes','Courbes'], ['barres','Barres']].map(function(p){
    return '<button type="button" data-v="' + p[0] + '" aria-pressed="' + (p[0] === state.moisView) + '">' + p[1] + '</button>';
  }).join('');
  tgV.addEventListener('click', function(e){
    var b = e.target.closest('button'); if (!b) return;
    state.moisView = b.getAttribute('data-v');
    [].forEach.call(tgV.querySelectorAll('button'), function(x){
      x.setAttribute('aria-pressed', x.getAttribute('data-v') === state.moisView);
    });
    renderMois(filtered());
  });

  var tgM = document.getElementById('tg-marque');
  tgM.innerHTML = ['budget','couv','vues','inter','eng','n'].map(function(k){
    return '<button type="button" data-m="' + k + '" aria-pressed="' + (k === state.metMarque) + '">' + METRIQUES[k].lab + '</button>';
  }).join('');
  tgM.addEventListener('click', function(e){
    var b = e.target.closest('button'); if (!b) return;
    state.metMarque = b.getAttribute('data-m');
    [].forEach.call(tgM.querySelectorAll('button'), function(x){
      x.setAttribute('aria-pressed', x.getAttribute('data-m') === state.metMarque);
    });
    render();
  });

  var tgT = document.getElementById('tg-top');
  tgT.innerHTML = Object.keys(TOPS).map(function(k){
    return '<button type="button" data-m="' + k + '" aria-pressed="' + (k === state.metTop) + '">' + TOPS[k].lab + '</button>';
  }).join('');
  tgT.addEventListener('click', function(e){
    var b = e.target.closest('button'); if (!b) return;
    state.metTop = b.getAttribute('data-m');
    [].forEach.call(tgT.querySelectorAll('button'), function(x){
      x.setAttribute('aria-pressed', x.getAttribute('data-m') === state.metTop);
    });
    renderTop(filtered());
  });

  document.getElementById('q-all').addEventListener('input', function(){
    state.q = this.value; state.allLimit = 100; renderAll(filtered());
  });
  document.getElementById('all-more').addEventListener('click', function(){
    state.allLimit += 100; renderAll(filtered());
  });
  document.getElementById('tb-all').addEventListener('click', function(e){
    var th = e.target.closest('th[data-sort]'); if (!th) return;
    var k = th.getAttribute('data-sort');
    if (state.allSort === k) state.allDir = -state.allDir;
    else { state.allSort = k; state.allDir = (ALL_COLS.filter(function(c){ return c.k === k; })[0] || {}).num ? -1 : 1; }
    renderAll(filtered());
  });

  legend('lg-mois', [['Couverture (personnes uniques)', SERIES[0]], ['Vues / impressions', SERIES[1]]]);
  legend('lg-op', [['Payante', SERIES[1]], ['Organique', SERIES[2]]]);

  var q = DATA.meta.qualite;
  document.getElementById('op-bad').textContent = fInt(q.payanteSupVues) + ' lignes';
  document.getElementById('q-links').textContent = fInt(q.sansLien);
  document.getElementById('q-format').textContent = fInt(q.sansFormat);
  document.getElementById('q-couv').textContent = fInt(q.sansCouverture);

  /* Entrée des sections : bornée et non liée au défilement — chaque bloc a
     rejoint son état final au plus tard à 1,05 s, qu'il soit à l'écran ou non.
     La barre de filtres en est exclue : une transform, même terminée, perturbe
     position:sticky. La bande de chiffres clés aussi, ses tuiles s'animant une
     à une dans renderKPI. */
  var aAnimer = [document.querySelector('.titleblock')]
    .concat([].slice.call(document.querySelectorAll('main > .section')).slice(1))
    .concat([document.querySelector('.method')]);
  aAnimer.forEach(function(el, i){
    if (!el) return;
    el.classList.add('anim-rise');
    el.style.animationDelay = Math.min(0.05 * i, 0.45).toFixed(2) + 's';
  });

  render();
  premierRendu = false;
})();
</script>
